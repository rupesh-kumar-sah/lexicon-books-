# Database
DATABASE_URL="postgresql://user:password@host:5432/database"
ADMIN_DATABASE_URL="postgresql://user:password@host:5432/database"

# Runtime
NODE_ENV="production"
PORT="5000"
FRONTEND_URL="https://your-service.onrender.com"
PUBLIC_BASE_URL="https://your-service.onrender.com"
RENDER_EXTERNAL_URL="https://your-service.onrender.com"
ALLOW_INDEXING="false"

# Authentication and admin security
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_PIN="replace-with-a-strong-pin"
ADMIN_SECRET_PATH="replace-with-a-long-random-admin-api-token"
VITE_ADMIN_PATH="/replace-with-a-non-obvious-admin-route"
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET="replace-with-a-long-random-secret"
PASSWORD_RESET_TTL_MINUTES="30"
PUBLIC_BASE_URL="https://YOUR_PUBLIC_LEXICON_BOOKS_DOMAIN"
ACCESS_TOKEN_MINUTES="10"
REFRESH_TOKEN_DAYS="30"
# WebAuthn/passkey settings. Set RP_ID to your production hostname and ORIGIN to the full HTTPS origin.
WEBAUTHN_RP_NAME="Lexicon Books"
WEBAUTHN_RP_ID="your-service.onrender.com"
WEBAUTHN_ORIGIN="https://your-service.onrender.com"
ADMIN_ALLOWED_COUNTRY=""
ADMIN_ALLOWED_LATITUDE=""
ADMIN_ALLOWED_LONGITUDE=""
ADMIN_ALLOWED_RADIUS_KM=""
GEOIP_PROVIDER_URL=""
GEOIP_PROVIDER_TOKEN=""

# Optional integrations
GROQ_API_KEY="replace-with-a-groq-server-key"
VITE_GOOGLE_MAPS_API_KEY=""
# Google OAuth web sign-in; callback is https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-service.onrender.com/api/auth/google/callback"
# Refresh token or service-account JSON stays server-side; never use a VITE_ prefix
GOOGLE_REFRESH_TOKEN=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Delivery-only Gmail integration. Authorize only https://www.googleapis.com/auth/gmail.send.
# Password recovery sends a one-time code to the requesting account; new-order notices go only to ORDER_NOTIFICATION_EMAIL.
# Keep the client secret and refresh token server-side; never use VITE_ prefixes or commit live values.
ORDER_NOTIFICATION_EMAIL="sahkkr702@gmail.com"
GMAIL_SENDER="sahkkr702@gmail.com"
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_ORDER_RANGE="Orders!A:O"
GOOGLE_SHEETS_BOOK_RANGE="Books!A:H"
GOOGLE_SHEETS_USER_RANGE="Users!A:E"

# Logging
LOG_ENABLED="false"
LOG_LEVEL="error"
