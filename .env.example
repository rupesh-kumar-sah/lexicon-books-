# Database
DATABASE_URL="postgresql://user:password@host:5432/database"
ADMIN_DATABASE_URL="postgresql://user:password@host:5432/database"

# Runtime
NODE_ENV="production"
PORT="5000"
FRONTEND_URL="https://your-service.onrender.com"
PUBLIC_BASE_URL="https://your-service.onrender.com"
RENDER_EXTERNAL_URL="https://your-service.onrender.com"
ALLOW_INDEXING="false"

# Authentication and admin security
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_PIN="replace-with-a-strong-pin"
ADMIN_SECRET_PATH="replace-with-a-long-random-admin-api-token"
VITE_ADMIN_PATH="/replace-with-a-non-obvious-admin-route"
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional integrations
GROQ_API_KEY="replace-with-a-groq-server-key"
VITE_GOOGLE_MAPS_API_KEY=""

# Logging
LOG_ENABLED="false"
LOG_LEVEL="error"
