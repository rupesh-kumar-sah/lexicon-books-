# Database
DATABASE_URL="postgresql://user:password@host:5432/database"
ADMIN_DATABASE_URL="postgresql://user:password@host:5432/database"

# Runtime
NODE_ENV="production"
PORT="5000"
FRONTEND_URL="https://your-service.onrender.com"
PUBLIC_BASE_URL="https://your-service.onrender.com"
RENDER_EXTERNAL_URL="https://your-service.onrender.com"
ALLOW_INDEXING="false"

# Authentication and admin security
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_PIN="replace-with-a-strong-pin"
ADMIN_SECRET_PATH="replace-with-a-long-random-admin-api-token"
VITE_ADMIN_PATH="/replace-with-a-non-obvious-admin-route"
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET="replace-with-a-long-random-secret"
PASSWORD_RESET_TTL_MINUTES="30"
PUBLIC_BASE_URL="https://YOUR_PUBLIC_LEXICON_BOOKS_DOMAIN"

# Optional integrations
GROQ_API_KEY="replace-with-a-groq-server-key"
VITE_GOOGLE_MAPS_API_KEY=""
# Google OAuth web sign-in; callback is https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-service.onrender.com/api/auth/google/callback"
# Refresh token or service-account JSON stays server-side; never use a VITE_ prefix
GOOGLE_REFRESH_TOKEN=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Gmail order notifications and private full-app Sheets snapshot
ORDER_NOTIFICATION_EMAIL="sahkkr702@gmail.com"
GMAIL_SENDER=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_ORDER_RANGE="Orders!A:O"
GOOGLE_SHEETS_BOOK_RANGE="Books!A:H"
GOOGLE_SHEETS_USER_RANGE="Users!A:E"

# Logging
LOG_ENABLED="false"
LOG_LEVEL="error"
