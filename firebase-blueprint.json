{
  "entities": {
    "book": {
      "title": "Book",
      "description": "Information about a book in the catalog.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "coverImage": { "type": "string" },
        "isbn": { "type": "string" },
        "genre": { "type": "string" },
        "stock": { "type": "integer" },
        "rating": { "type": "number" },
        "featured": { "type": "boolean" }
      },
      "required": ["title", "author", "price", "isbn", "genre", "stock"]
    },
    "userProfile": {
      "title": "User Profile",
      "description": "Extended information about an authenticated user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["uid", "email", "role"]
    },
    "order": {
      "title": "Order",
      "description": "Details of a customer purchase.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "stripeSessionId": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["userId", "items", "total", "status", "createdAt"]
    },
    "review": {
      "title": "Review",
      "description": "A customer review for a specific book.",
      "type": "object",
      "properties": {
        "bookId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["bookId", "userId", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": "book",
      "description": "Main product catalog."
    },
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User accounts and roles."
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Transaction history."
    },
    "/books/{bookId}/reviews/{reviewId}": {
      "schema": "review",
      "description": "Product reviews."
    }
  }
}
